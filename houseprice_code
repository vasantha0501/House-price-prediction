#############################
# Server
#############################

server <- function(input, output, session){
  
  output$localityUI <- renderUI({
    
    localities <-
      
      data %>%
      
      filter(city==input$city) %>%
      
      pull(locality) %>%
      
      unique()
    
    selectInput(
      
      "locality",
      
      "Select Locality",
      
      choices=sort(localities)
      
    )
    
  })
  
  output$areaUI <- renderUI({
    
    areas <-
      
      data %>%
      
      filter(
        
        city==input$city,
        
        locality==input$locality
        
      ) %>%
      
      pull(area) %>%
      
      unique()
    
    selectInput(
      
      "area",
      
      "Select Area",
      
      choices=sort(areas)
      
    )
    
  })
  
  observeEvent(input$predict,{
    
    newdata <- data.frame(
      
      Year=2027,
      
      city=factor(
        input$city,
        levels=levels(long_data$city)
      ),
      
      locality=factor(
        input$locality,
        levels=levels(long_data$locality)
      ),
      
      area=factor(
        input$area,
        levels=levels(long_data$area)
      )
      
    )
    
    pred <- predict(model,newdata)
    
    output$prediction <- renderText({
      
      paste0(
        "₹ ",
        format(round(pred,2), big.mark=",")
      )
      
    })
    
  })
  
}

