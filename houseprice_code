library(shiny)
library(readxl)
library(dplyr)
library(tidyr)

#############################
# Read Dataset
#############################

data <- read_excel(
  "D://santhi//owndata.xlsx",
  sheet = "Sheet2"
)

colnames(data)[1:3] <- c("city","locality","area")

#############################
# Convert Wide to Long
#############################

long_data <- pivot_longer(
  data,
  cols = `2021`:`2026`,
  names_to = "Year",
  values_to = "Price"
)

long_data$Year <- as.numeric(long_data$Year)

long_data$city <- factor(long_data$city)
long_data$locality <- factor(long_data$locality)
long_data$area <- factor(long_data$area)

#############################
# Regression Model
#############################

model <- lm(
  Price ~ Year + city + locality + area,
  data = long_data
)

